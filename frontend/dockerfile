# Source: https://v2.vuejs.org/v2/cookbook/dockerize-vuejs-app.html

# Choose the Image which has Node installed already
# Pinned: the Vue CLI toolchain in yarn.lock does not support newer Node versions
FROM node:16-alpine

# install simple http server for serving static content
RUN npm install -g http-server

# make the 'app' folder the current working directory
WORKDIR /app

# API location, baked in at build time. Relative, so the reverse proxy serves
# the backend under /api on the same domain as the frontend.
# Override with: docker build --build-arg VUE_APP_API_URL=https://example.com/api .
ARG VUE_APP_API_URL=/api
ENV VUE_APP_API_URL=$VUE_APP_API_URL

# copy 'package.json' and 'yarn.lock'
COPY package.json yarn.lock ./

# install the exact dependency versions pinned in yarn.lock
RUN yarn install --frozen-lockfile

# copy project files and folders to the current working directory (i.e. 'app' folder)
COPY . .

# build app for production with minification
RUN yarn build

EXPOSE 8080
CMD [ "http-server", "dist" ]